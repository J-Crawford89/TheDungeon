script = ExtResource("1_8s7ie")
Id = "melee_weapons"
Name = "Melee Weapons"
Description = "Melee Weapons are weapons used to attack a target by closing in and swinging directly toward it to physically strike a target. Melee Weapons typically use your Might Score to for attack and damage rolls."
