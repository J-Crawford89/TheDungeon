[resource]
script = ExtResource("1_ily7t")
Id = "farmboy"
Name = "Farmboy or Farmgirl"
Description = "Farmboys and Farmgirls are exactly what they sound like. Before heading off on adventurers, you were a simple farmboy or farmgirl, tending to another's farm, be that your parents or some other employer. Farmboys and Farmgirls are great with animals and agriculture and have a knack for intense physical labor."
StartingGold = 12
