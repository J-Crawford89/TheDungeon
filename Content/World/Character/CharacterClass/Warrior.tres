[resource]
script = ExtResource("1_kl110")
Id = "warrior"
Name = "Warrior"
Description = "Warriors are as balanced of a fighting class as you can find. They perfectly balance Might and Agility, Constitution and Dexterity. The Warrior forgoes the Knight's heavy armor, but is all the quicker for it."
BaseHp = 8
